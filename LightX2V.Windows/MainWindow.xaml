       <TextBlock Text="{Binding T[Download enhancement models when needed. Turn enhancement off to create with the base model.]}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="1,0,1,12"/>
       <ContentControl Content="{Binding T2ICard}" ContentTemplate="{StaticResource ModelCardTemplate}"/>
       <ContentControl Content="{Binding I2ICard}" ContentTemplate="{StaticResource ModelCardTemplate}"/>
      </StackPanel>
     </Expander>
     <Expander x:Name="ParametersSection" Style="{StaticResource SidebarSection}" IsExpanded="{Binding ParametersExpanded,Mode=TwoWay}" AutomationProperties.Name="{Binding T[Generation settings]}">
<Expander.Header><Grid Height="60"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><TextBlock  Text="{Binding T[Generation settings]}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Expander.Header>
      <StackPanel x:Name="ParametersSectionContent" Margin="20,18,20,0">
     <TextBlock Text="{Binding T[Image size]}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,0,18"><UniformGrid Columns="3">
      <RadioButton Content="512" IsChecked="{Binding Tier,Mode=TwoWay,Converter={StaticResource TierChoice},ConverterParameter=0}" GroupName="Resolution" Style="{DynamicResource ResolutionRadio}"/>
      <RadioButton Content="1K" IsChecked="{Binding Tier,Mode=TwoWay,Converter={StaticResource TierChoice},ConverterParameter=1}" GroupName="Resolution" Style="{DynamicResource ResolutionRadio}"/>
      <RadioButton x:Name="Resolution2K" Content="2K" IsChecked="{Binding Tier,Mode=TwoWay,Converter={StaticResource TierChoice},ConverterParameter=2}" GroupName="Resolution" Style="{DynamicResource ResolutionRadio}" AutomationProperties.AutomationId="Resolution2K"/>
     </UniformGrid></Border>
   <TextBlock Text="{Binding T[Aspect ratio]}" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
   <ItemsControl ItemsSource="{x:Static local:Presets.Ratios}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="RatioClicked" Tag="{Binding}" Height="63" Margin="0,0,5,6" Padding="3"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource Equal}"><Binding/><Binding Path="DataContext.Ratio" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="#F7EEEC"/><Setter Property="BorderBrush" Value="#A45145"/><Setter Property="Foreground" Value="#A45145"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Grid Height="25"><Rectangle Width="{Binding Converter={StaticResource RatioIcon},ConverterParameter=width}" Height="{Binding Converter={StaticResource RatioIcon},ConverterParameter=height}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Fill="#0B6B6B6B" RadiusX="2" RadiusY="2" StrokeThickness="1"><Rectangle.Style><Style TargetType="Rectangle"><Style.Triggers><DataTrigger Binding="{Binding}" Value="Adaptive"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle><Viewbox Width="18" Height="18"><Viewbox.Style><Style TargetType="Viewbox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="Adaptive"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Viewbox.Style><Path Data="M3,10 V3 H10 M3,3 L21,21 M14,21 H21 V14" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Viewbox></Grid><TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"><TextBlock.Text><MultiBinding Converter="{StaticResource Localized}"><Binding/><Binding Path="DataContext.T.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border Background="#F5F5F5" CornerRadius="8" Padding="10,11" Margin="0,5,0,20"><DockPanel><TextBlock Text="{Binding T[Output size]}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/><TextBlock Text="{Binding SizeText}" FontWeight="Medium" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas"/></DockPanel></Border>
      </StackPanel>
     </Expander>
    </StackPanel></ScrollViewer>
   </Grid>
  </Border>
  <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="MinimizeButton" Click="Minimize" Style="{StaticResource CaptionButton}" ToolTip="{Binding T[Minimize]}"><TextBlock Text="─" FontSize="12"/></Button><Button x:Name="MaximizeButton" Click="Maximize" Style="{StaticResource CaptionButton}" ToolTip="{Binding T[Maximize]}"><TextBlock Text="□" FontSize="15"/></Button><Button x:Name="CloseButton" Click="CloseWindow" Style="{StaticResource CloseCaptionButton}" ToolTip="{Binding T[Close]}"><TextBlock Text="×" FontSize="20"/></Button></StackPanel>
 </Grid>


     <Grid Grid.Row="1" Margin="0,0,0,8"><TextBox x:Name="PromptEditor" BorderThickness="0" FocusVisualStyle="{x:Null}" Text="{Binding Prompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="28" MaxHeight="130" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderBrush="Transparent" Padding="0,2" FontSize="13" AutomationProperties.AutomationId="PromptEditor"/><TextBlock Text="{Binding T[Describe the image you want to create…]}" IsHitTestVisible="False" Foreground="#999999" FontSize="13" Margin="1,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Prompt}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="AddImagesButton" Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding AddImagesCommand}" Margin="0,0,7,0" ToolTip="{Binding T[Add reference images]}" AutomationProperties.Name="{Binding T[Add reference images]}" AutomationProperties.AutomationId="AddImages"><Viewbox Width="16" Height="16"><Path Data="M8,1 V15 M1,8 H15" Stroke="{StaticResource Ink}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button>
      <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="7" Padding="10,0" Height="30"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,8,0"><Path Data="{StaticResource CubeGeometry}" Stroke="{StaticResource Ink}" StrokeThickness="1.5" StrokeLineJoin="Round"/></Viewbox><TextBlock Text="Qwen-Image-2.1-Turbo" FontSize="11" FontWeight="Medium"/></StackPanel></Border>
      <Button x:Name="GenerateButton" Grid.Column="3" Style="{StaticResource GenerateButton}" Command="{Binding GenerateCommand}" ToolTip="{Binding GenerateLabel}" AutomationProperties.Name="{Binding GenerateLabel}" AutomationProperties.AutomationId="Generate" Visibility="{Binding IsGenerationBusy,Converter={StaticResource NotBool}}"><Viewbox Width="15" Height="17"><Path Data="M8,18 V2 M2,8 L8,2 14,8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button>
      <Button Grid.Column="3" Style="{StaticResource Primary}" Command="{Binding GenerateCommand}" ToolTip="{Binding GenerateLabel}" AutomationProperties.Name="{Binding GenerateLabel}" x:Name="StopButton" AutomationProperties.AutomationId="Stop" Visibility="{Binding IsGenerationBusy,Converter={StaticResource Bool}}" Padding="12,0" Height="32"><StackPanel Orientation="Horizontal"><Rectangle Fill="White" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding GenerateLabel}" FontSize="11"/></StackPanel></Button>
     </Grid>
    </Grid>
   </Border>
   <TextBlock Grid.Row="4" Text="{Binding VisibleToast}" Visibility="{Binding VisibleToast,Converter={StaticResource NonEmpty}}" Margin="30,-12,30,8" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Toast}"/>

  </Grid>
  <Border x:Name="Inspector" Grid.Column="2" Background="#FAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="{Binding ShowInspector,Converter={StaticResource Bool}}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*" MinHeight="0"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="InspectorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Expander x:Name="ModelSection" Style="{StaticResource SidebarSection}" IsExpanded="{Binding ModelExpanded,Mode=TwoWay}" AutomationProperties.Name="{Binding T[Model preparation]}">
<Expander.Header><Grid Height="54"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><TextBlock x:Name="ModelHeading" Text="{Binding T[Model preparation]}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Viewbox Grid.Column="1" Width="15" Height="15" VerticalAlignment="Center"><Path Data="{StaticResource CubeGeometry}" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/></Viewbox></Grid></Expander.Header>
      <StackPanel x:Name="ModelSectionContent" Margin="20,14,20,16">
       <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding T[Download source]}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Grid.Column="1" Command="{Binding DownloadAllCommand}" FontSize="10" Padding="3,4" AutomationProperties.AutomationId="DownloadAllModels"><StackPanel Orientation="Horizontal"><TextBlock Text="↓" FontSize="14" Margin="0,-3,6,0"/><TextBlock Text="{Binding DownloadAllLabel}" FontSize="10"/></StackPanel></Button></Grid>

        <StackPanel>
         <RadioButton Content="{Binding T[Automatic (recommended)]}" IsChecked="{Binding UseAutomaticDownloadSource,Mode=TwoWay}" GroupName="DownloadSource" Style="{StaticResource ResolutionRadio}" AutomationProperties.AutomationId="DownloadSourceAuto"/>

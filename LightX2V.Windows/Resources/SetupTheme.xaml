<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="SetupSecondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#F5F5F5"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="34"/></Style>
 <Style x:Key="SetupSegment" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Face" Background="Transparent" CornerRadius="6" Padding="10,5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#151515"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SetupChoice" TargetType="RadioButton">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Face" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="15" Height="15" VerticalAlignment="Top" Margin="0,3,0,0"><Ellipse x:Name="Ring" Stroke="#A0A0A0" StrokeThickness="1.2"/><Ellipse x:Name="Dot" Fill="#242424" Margin="4" Visibility="Collapsed"/></Grid><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#555555"/><Setter TargetName="Face" Property="Background" Value="#FAFAFA"/><Setter TargetName="Ring" Property="Stroke" Value="#242424"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#F5F5F5"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SetupLog" TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Background="White"><StackPanel><ToggleButton IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Stretch" Cursor="Hand"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Padding="12,10" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/><Path x:Name="Arrow" Grid.Column="1" Data="M1,1 L5,5 1,9" Stroke="{StaticResource Muted}" StrokeThickness="1.2" Width="5" Height="8" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}"/></ToggleButton><ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" Margin="12,0,12,12"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <DataTemplate x:Key="EnvironmentCandidateCard">
  <Border CornerRadius="12" Background="#F6F6F6" Padding="16" Margin="0,0,0,12">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Width="14" Height="14" VerticalAlignment="Center"><Ellipse><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#989898"/><Style.Triggers><DataTrigger Binding="{Binding Ready}" Value="True"><Setter Property="Fill" Value="#47755D"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><Path Stroke="White" StrokeThickness="1.2"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M4,4 L10,10 M4,10 L10,4"/><Style.Triggers><DataTrigger Binding="{Binding Ready}" Value="True"><Setter Property="Data" Value="M3.5,7 L6,9.5 10.5,4.5"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid>
     <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="6,0,10,0"/>
     <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding DataContext.T[Needs attention],RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="Foreground" Value="#8A635C"/><Style.Triggers><DataTrigger Binding="{Binding Ready}" Value="True"><Setter Property="Foreground" Value="#47755D"/><Setter Property="Text" Value="{Binding DataContext.T[Available],RelativeSource={RelativeSource AncestorType=Window}}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="28,9,0,5" FontFamily="Consolas"/>
    <TextBlock Text="{Binding RuntimeSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="28,0,0,4"/>
    <ItemsControl ItemsSource="{Binding VersionRows}" Margin="28,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,3,14,0"><TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Version}" Margin="10,0,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{Binding BackendLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="28,4,0,0"/>
    <TextBlock Text="{Binding Device}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="28,6,0,0"/>
    <TextBlock Text="{Binding ResourceSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="28,5,0,0"/>
    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="#8A635C" Margin="28,6,0,0" Visibility="{Binding Ready,Converter={StaticResource NotBool}}"/>
    <Button Command="{Binding DataContext.SelectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding Ready}" Content="{Binding DataContext.T[Use this environment],RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" Style="{StaticResource SetupSecondary}" Margin="0,12,0,0" AutomationProperties.AutomationId="SelectEnvironment"/>
   </StackPanel>
  </Border>
 </DataTemplate>
</ResourceDictionary>
